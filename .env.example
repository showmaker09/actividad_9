# ==============================================================================
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copia este archivo a '.env' y completa con tus credenciales reales de Atlas
# ==============================================================================

# Cadena de conexión a MongoDB Atlas (Connection String)
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_URI=mongodb+srv://usuario_ejemplo:password_seguro@cluster0.abcde.mongodb.net/?appName=BibliotecaApp

# Nombre de la base de datos a utilizar (por defecto: biblioteca_virtual)
DB_NAME=biblioteca_virtual

